<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      NightCache : caches RAM (CacheManager / CacheSpec / PlayerStates) et persistance SQLite locale
      (PersistenceManager, Data/<Plugin>/) pour plugins Bukkit / Spigot / Paper / Folia, Minecraft 1.8 → 1.21.11,
      Java 21. Distribué par les releases GitHub : chaque plugin télécharge NightCache.jar dans plugins/<Plugin>/libs/,
      le relocalise sous son propre package (l'état est statique : une copie par plugin) et l'injecte au chargement.

      Version : ${revision}, fixée par la CI (major.minor du pom + numéro de build). Le major de l'API est écrit
      dans le manifeste (NightCache-Api) : un plugin refuse un jar d'un autre major.
    -->
    <groupId>weeno</groupId>
    <artifactId>night-cache</artifactId>
    <version>${revision}</version>
    <packaging>jar</packaging>
    <name>NightCache</name>
    <description>Caches RAM + persistance SQLite légers, sans fuite, pour plugins Minecraft 1.8 → 1.21.11 (Java 21)</description>
    <url>https://github.com/NightProjectS/NightCache</url>

    <properties>
        <!-- Surchargé par la CI : -Drevision=1.0.<build> -->
        <revision>1.0.0-SNAPSHOT</revision>
        <nightcache.api>1</nightcache.api>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- API de compilation : Spigot 1.8.8 (plus petit dénominateur commun). Profil mc-latest : Paper 1.21.11. -->
        <bukkit.groupId>org.spigotmc</bukkit.groupId>
        <bukkit.artifactId>spigot-api</bukkit.artifactId>
        <bukkit.version>1.8.8-R0.1-SNAPSHOT</bukkit.version>
        <!-- 2e pilote des tests de stockage (serveurs récents). -->
        <sqlite.recent.version>3.45.3.0</sqlite.recent.version>
        <!-- Compatibilité binaire contre la dernière release publiée (jar téléchargé par la CI). -->
        <japicmp.baseline>${project.build.directory}/baseline/NightCache.jar</japicmp.baseline>
        <japicmp.skip>true</japicmp.skip>
        <japicmp.current>${project.build.directory}/NightCache.jar</japicmp.current>
    </properties>

    <repositories>
        <repository>
            <id>spigotmc</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <profiles>
        <!-- Vérification de compatibilité (CI) : même code compilé contre l'API la plus récente. -->
        <profile>
            <id>mc-latest</id>
            <properties>
                <bukkit.groupId>io.papermc.paper</bukkit.groupId>
                <bukkit.artifactId>paper-api</bukkit.artifactId>
                <bukkit.version>1.21.11-R0.1-SNAPSHOT</bukkit.version>
            </properties>
        </profile>
    </profiles>

    <build>
        <finalName>NightCache</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${java.version}</release>
                    <compilerArgs>
                        <arg>-Xlint:all,-processing,-serial,-deprecation,-removal</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <!--
              Compatibilité binaire de l'API 1.x : la CI télécharge la dernière release dans target/baseline/ et lance
              le build avec -Djapicmp.skip=false ; toute suppression ou modification incompatible fait échouer le build.
            -->
            <plugin>
                <groupId>com.github.siom79.japicmp</groupId>
                <artifactId>japicmp-maven-plugin</artifactId>
                <version>0.23.1</version>
                <executions>
                    <execution>
                        <id>api-compat</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>cmp</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <skip>${japicmp.skip}</skip>
                    <oldVersion>
                        <file>
                            <path>${japicmp.baseline}</path>
                        </file>
                    </oldVersion>
                    <newVersion>
                        <file>
                            <path>${japicmp.current}</path>
                        </file>
                    </newVersion>
                    <parameter>
                        <onlyModified>true</onlyModified>
                        <breakBuildOnBinaryIncompatibleModifications>true</breakBuildOnBinaryIncompatibleModifications>
                        <ignoreMissingClasses>true</ignoreMissingClasses>
                        <excludes>
                            <exclude>weeno.nightcache.libs.*</exclude>
                        </excludes>
                    </parameter>
                </configuration>
            </plugin>
            <!-- Chargeur de référence (loader/, copié dans les plugins) compilé et testé avec les tests. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>loader-tests</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>add-test-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>loader</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Pilote SQLite récent (serveurs modernes) copié pour la 2e passe des tests de stockage. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>sqlite-recent</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.xerial</groupId>
                                    <artifactId>sqlite-jdbc</artifactId>
                                    <version>${sqlite.recent.version}</version>
                                    <destFileName>sqlite-jdbc.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>${project.build.directory}/sqlite-recent</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
              Tests : passe complète sur sqlite-jdbc 3.7.2 (pilote des serveurs 1.8), puis les tests @Tag("sqlite")
              rejoués sur le pilote récent. Répertoire de travail dans target/ : Data/<Plugin>/ y est créé.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <workingDirectory>${project.build.directory}/surefire-work</workingDirectory>
                    <!-- Une JVM par classe : état statique de la lib, Bukkit factice et pilote natif SQLite isolés. -->
                    <reuseForks>false</reuseForks>
                    <systemPropertyVariables>
                        <nightcache.sqlite>3.7</nightcache.sqlite>
                        <nightcache.basedir>${project.basedir}</nightcache.basedir>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <id>sqlite-recent</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <groups>sqlite</groups>
                            <classpathDependencyExcludes>
                                <classpathDependencyExclude>org.xerial:sqlite-jdbc</classpathDependencyExclude>
                            </classpathDependencyExcludes>
                            <additionalClasspathElements>
                                <additionalClasspathElement>${project.build.directory}/sqlite-recent/sqlite-jdbc.jar</additionalClasspathElement>
                            </additionalClasspathElements>
                            <reportsDirectory>${project.build.directory}/surefire-reports-sqlite-recent</reportsDirectory>
                            <workingDirectory>${project.build.directory}/surefire-work-sqlite-recent</workingDirectory>
                            <systemPropertyVariables>
                                <nightcache.sqlite>3.45</nightcache.sqlite>
                                <nightcache.basedir>${project.basedir}</nightcache.basedir>
                            </systemPropertyVariables>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Implementation-Title>NightCache</Implementation-Title>
                            <Implementation-Version>${project.version}</Implementation-Version>
                            <NightCache-Api>${nightcache.api}</NightCache-Api>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <!-- Caffeine embarqué et relocalisé sous le package de la lib : la relocation
                                 weeno.nightcache appliquée par chaque plugin le couvre aussi. -->
                            <artifactSet>
                                <includes>
                                    <include>com.github.ben-manes.caffeine:caffeine</include>
                                </includes>
                            </artifactSet>
                            <relocations>
                                <relocation>
                                    <pattern>com.github.benmanes.caffeine</pattern>
                                    <shadedPattern>weeno.nightcache.libs.caffeine</shadedPattern>
                                </relocation>
                            </relocations>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/versions/**</exclude>
                                        <exclude>META-INF/maven/**</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <!-- API Bukkit + gson (+ pilote SQLite) : fournis par le serveur. -->
        <dependency>
            <groupId>${bukkit.groupId}</groupId>
            <artifactId>${bukkit.artifactId}</artifactId>
            <version>${bukkit.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>26.0.2</version>
            <scope>provided</scope>
        </dependency>
        <!-- Tests : JUnit 5 et le pilote SQLite 3.7.2 des serveurs 1.8 (le plus ancien supporté). -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.7.2</version>
            <scope>test</scope>
        </dependency>
        <!-- Relocalisation du chargeur (loader/), comme dans les plugins. -->
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm-commons</artifactId>
            <version>9.7.1</version>
            <scope>test</scope>
        </dependency>
        <!-- Requis à l'exécution par sqlite-jdbc récent (2e passe des tests). -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>1.7.36</version>
            <scope>test</scope>
        </dependency>
        <!-- Seule dépendance embarquée (relocalisée) : W-TinyLFU pour les caches objet. -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
            <version>3.1.8</version>
        </dependency>
    </dependencies>
</project>
